# Server Environment Variables
PORT=5001
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017/job_mailer

# Dry Run Mode: when true, emails are simulated and logged without actually reaching SMTP
DRY_RUN=true

# SMTP Configuration (Keep your real passwords private!)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Personal Info for Application Templates
SENDER_NAME=Jeny Pansuriya
SENDER_EMAIL=jeny.pansuriya@example.com
SENDER_PHONE=+91 9876543210
PORTFOLIO_URL=https://jenypansuriya.dev
GITHUB_URL=https://github.com/jenypansuriya

# Queue & Safety Limits
DAILY_EMAIL_LIMIT=20
MIN_DELAY_SECONDS=10
MAX_DELAY_SECONDS=30
MAX_EMAILS_PER_RUN=10
RESUME_PATH=attachments/Jeny_Pansuriya_Resume.pdf
